FROM python:3.13.3-slim AS builder

WORKDIR /build

COPY requirements.txt ./
RUN pip3 install --require-hashes --no-cache-dir --prefix=/install -r requirements.txt

# Test stage: test deps and unit tests never reach the final image
FROM python:3.13.3-slim AS test

COPY --from=builder /install /usr/local

COPY test-requirements.txt /tmp/
RUN pip3 install --require-hashes --no-cache-dir -r /tmp/test-requirements.txt

WORKDIR /opt/microservices
COPY productpage.py ./
COPY tests/unit/* ./
COPY templates ./templates
COPY static ./static
RUN python -m unittest discover && touch /tests-passed

FROM python:3.13.3-slim

COPY --from=builder /install /usr/local

# Forces the test stage to run (and pass) as part of every build
COPY --from=test /tests-passed /tmp/tests-passed

WORKDIR /opt/microservices
COPY productpage.py requirements.txt ./
COPY templates ./templates
COPY static ./static

ARG flood_factor
ENV FLOOD_FACTOR=${flood_factor:-0}

EXPOSE 9080

CMD ["gunicorn", "-b", "[::]:9080", "productpage:app", "-w", "8", "--keep-alive", "2", "-k", "gevent"]

USER 1000
